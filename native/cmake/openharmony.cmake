# Optional cross-build for the portable library and examples. No device use.
# Set OHOS_SDK to the OpenHarmony native SDK root before configuring.
if(NOT DEFINED ENV{OHOS_SDK})
    message(FATAL_ERROR "Set OHOS_SDK to the OpenHarmony native SDK root")
endif()
file(TO_CMAKE_PATH "$ENV{OHOS_SDK}" OHOS_SDK_ROOT)
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER "${OHOS_SDK_ROOT}/llvm/bin/clang.exe")
set(CMAKE_CXX_COMPILER "${OHOS_SDK_ROOT}/llvm/bin/clang++.exe")
if(NOT CMAKE_HOST_WIN32)
    set(CMAKE_C_COMPILER "${OHOS_SDK_ROOT}/llvm/bin/clang")
    set(CMAKE_CXX_COMPILER "${OHOS_SDK_ROOT}/llvm/bin/clang++")
endif()
set(CMAKE_C_COMPILER_TARGET aarch64-linux-ohos)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-ohos)
set(CMAKE_SYSROOT "${OHOS_SDK_ROOT}/sysroot")
set(CMAKE_AR "${OHOS_SDK_ROOT}/llvm/bin/llvm-ar")
set(CMAKE_RANLIB "${OHOS_SDK_ROOT}/llvm/bin/llvm-ranlib")
if(CMAKE_HOST_WIN32)
    set(CMAKE_AR "${OHOS_SDK_ROOT}/llvm/bin/llvm-ar.exe")
    set(CMAKE_RANLIB "${OHOS_SDK_ROOT}/llvm/bin/llvm-ranlib.exe")
endif()
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
