# Add these sources to the existing Native user-space service's GN build.
# Use that service's actual OHOS dependencies and C++ runtime configuration.
config("ops_headers") {
  include_dirs = [ "../source/native/include", "../source/collector/include" ]
}
static_library("harmony_vma_collector") {
  sources = [ "../source/collector/device/collector.c" ]
  include_dirs = [ "../source/collector/include" ]
  cflags = [ "-fPIC" ]
}
static_library("harmony_operation_recognition") {
  sources = [
    "../source/native/src/recognition.cpp",
    "../source/native/src/feature.cpp",
    "../source/native/src/pipeline.cpp",
    "../source/native/src/runtime.cpp",
    "../source/native/src/stream.cpp",
    "../source/native/src/replay.cpp",
    "../source/native/src/service_c.cpp",
  ]
  include_dirs = [ "../source/native/include", "../source/collector/include" ]
  cflags_cc = [ "-std=c++17", "-fexceptions", "-fPIC" ]
  deps = [ ":harmony_vma_collector" ]
}
static_library("harmony_operation_host") {
  sources = [ "../source/native/src/embedded.cpp", "platform_bridge.cpp" ]
  public_configs = [ ":ops_headers" ]
  cflags_cc = [ "-std=c++17", "-fexceptions", "-fPIC" ]
  public_deps = [ ":harmony_operation_recognition" ]
}
# The existing service adds one dependency: :harmony_operation_host.
# Match the existing service's exceptions, libc++, visibility and architecture.
